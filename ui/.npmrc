# npm 12+ blocks dependency install scripts by default (supply-chain hardening).
# Electron's postinstall is what DOWNLOADS the Electron binary, so without this
# `npm install` succeeds while leaving the app unable to start with
# "Electron failed to install correctly".
#
# package.json also carries an "allowScripts" entry for electron; npm's own
# EALLOWSCRIPTS error explicitly points at package.json OR .npmrc, so both are
# set - whichever the installed npm honours, the binary gets downloaded.
# Scoped to electron only, never a blanket allow.
allow-scripts=electron
