{
  "name": "klipzy-studio",
  "version": "1.1.4",
  "description": "Klipzy Studio - local-first Long Form to Shorts studio by TechFreq",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "author": "TechFreq Developments",
  "license": "SEE LICENSE IN ../LICENSE.md",
  "devDependencies": {
    "electron": "^43.7.0",
    "electron-builder": "^26.15.3"
  },
  "//allowScripts": "npm 12+ blocks dependency install scripts by default (a supply-chain hardening change). Electron's postinstall is what DOWNLOADS the actual Electron binary, so with it blocked `npm install` appears to succeed and then `npm start` dies with 'Electron failed to install correctly'. Approving electron by name (not version-pinned) keeps that working across upgrades. Older npm ignores this field and runs the script anyway, so it is safe on every version. Deliberately minimal: only electron, never `approve --all`.",
  "allowScripts": {
    "electron": true
  },
  "build": {
    "appId": "com.techfreq.klipzy-studio",
    "productName": "Klipzy Studio",
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "../scripts/main.py",
        "to": "main.py"
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Klipzy Studio"
    },
    "mac": {
      "target": "dmg",
      "icon": "../assets/icon.png",
      "category": "public.app-category.video"
    },
    "linux": {
      "target": "AppImage",
      "icon": "../assets/icon.png",
      "category": "AudioVideo"
    }
  }
}
