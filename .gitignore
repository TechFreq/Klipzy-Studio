# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv_win/
venv/
env/
.pytest_cache/

# Node / Electron
node_modules/
dist/
out/
*.log

# Output clips
output/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/

# Temp
gitstatus.txt

# Local API token generated at runtime (never commit a secret)
logs/api_token.txt
# Hugging Face token for optional diarization (never commit a secret)
logs/hf_token.txt
# Remembered local LLM pick (machine-specific runtime preference)
logs/preferred_ollama_model.txt

# ML model weights downloaded on first use (YOLO etc.)
*.pt

# Pre-restore backup of the deleted stub + old UI files (local safety copy)
_prerestore_backup/

# Internal/personal developer notes — kept locally, never pushed to the public repo
Developer of Klipzy studio/

# Local-only working docs (session handoff + dev/testing notes + resume prompt).
# Kept local, never committed.
SESSION_HANDOFF.md
DEV_TESTING.md
NEXT_SESSION_PROMPT.md

# Development-only test suites & scaffolding — kept local, never shipped in the
# public repo. Run locally with `node --test` (frontend) and pytest (backend).
# The Python suite that used to be tracked here has been untracked (it stays on
# disk locally); this rule keeps it and any new tests out of the public repo.
# jsdom lives in node_modules (also ignored), so no test tooling leaks into
# package.json.
/ui/test/
/tests/

# Internal developer notes / codebase audits.
/dev/
